# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase ---------------------------------------------------------------------
# Configure these in AI Studio Secrets / your host (server-side only).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Direct Postgres connection (Project Settings > Database). Used by the /api/v1
# routes (transactional SET LOCAL + RLS) and the worker. Port 6543 (transaction
# pooler) works too. DATABASE_URL is accepted as an alias.
SUPABASE_DB_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX="10"
# Only for projects still on the legacy HS256 JWT secret. Leave empty to verify
# access tokens against the project's JWKS.
SUPABASE_JWT_SECRET=""

# --- WhatsApp Cloud API (Taimoor) ------------------------------------------------------
# Webhook secret (HMAC-SHA256 verification of inbound messages)
WHATSAPP_APP_SECRET=""
# 32-byte hex key for AES-256-GCM encryption of WhatsApp tokens at rest
TOKEN_ENCRYPTION_KEY=""

# Private Storage buckets (created by the storage migration).
VOICE_NOTES_BUCKET="voice-notes"
PAYMENT_PROOFS_BUCKET="payment-proofs"

# 32 random bytes, base64. Encrypts Meta page tokens. Never change it once set.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Web push (PWA) ---------------------------------------------------------
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@your-domain.pk"

# --- WhatsApp (platform number, used for agent alerts) -----------------------
# Until Taimoor's sender lands, all template messages go through this number.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Approved utility template with two body params: {{1}} title, {{2}} details.
WHATSAPP_AGENT_ALERT_TEMPLATE="agent_alert"
# Meta's per-message charge in PKR, billed to partners as pass-through.
WHATSAPP_COST_PKR="0"

# --- Meta lead ads -------------------------------------------------------------
# Meta app > Webhooks > Page > leadgen: callback https://<app>/api/v1/hooks/meta/leadgen
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# --- Billing -------------------------------------------------------------------
BILLING_TIMEZONE="Asia/Karachi"

# Worker (npm run worker): how often to poll for jobs when the queue is empty.
WORKER_POLL_MS="1000"

# --- Frontend ---------------------------------------------------------------------
# API mocks (docs/frontend-endpoint-map.md): all | missing | off.
# Unset: "all" in development without a database, otherwise "missing".
NEXT_PUBLIC_API_MOCKING=""
# Send WhatsApp messages through the Cloud API instead of click-to-chat (wa.me).
NEXT_PUBLIC_WHATSAPP_CLOUD_API="false"
# Show /dev/* pages and the dev switcher outside development.
NEXT_PUBLIC_ENABLE_DEV_TOOLS="false"
