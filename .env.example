# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend (Supabase) -------------------------------------------------------
# Direct Postgres connection string (Supabase: Project Settings > Database).
# Port 6543 (transaction pooler) works too; prepared statements are turned off for it.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX="10"

# Supabase project URL. Used for Storage uploads (voice notes) and, when
# SUPABASE_JWT_SECRET is empty, to verify access tokens against the project's JWKS.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Only for projects still on the legacy HS256 JWT secret. Leave empty to use JWKS.
SUPABASE_JWT_SECRET=""
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Private Storage buckets (created by the storage migration).
VOICE_NOTES_BUCKET="voice-notes"
PAYMENT_PROOFS_BUCKET="payment-proofs"

# 32 random bytes, base64. Encrypts Meta page tokens. Never change it once set.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Web push (PWA) ---------------------------------------------------------
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@your-domain.pk"

# --- WhatsApp (platform number, used for agent alerts) -----------------------
# Until Taimoor's sender lands, all template messages go through this number.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Approved utility template with two body params: {{1}} title, {{2}} details.
WHATSAPP_AGENT_ALERT_TEMPLATE="agent_alert"
# Meta's per-message charge in PKR, billed to partners as pass-through.
WHATSAPP_COST_PKR="0"

# --- Meta lead ads -------------------------------------------------------------
# Meta app > Webhooks > Page > leadgen: callback https://<app>/api/v1/hooks/meta/leadgen
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# --- Billing -------------------------------------------------------------------
BILLING_TIMEZONE="Asia/Karachi"

# Worker (npm run worker): how often to poll for jobs when the queue is empty.
WORKER_POLL_MS="1000"
